# Archive — local-only scratch and superseded artifacts
archive/
# ...but the retired-documents archive is source, not an artifact. The rule
# above is unanchored, so it swallows any directory named `archive` at any
# depth; this re-includes the one that holds documentation.
!docs/archive/

# ESP-IDF build output
#
# build_* as well as build/: the out-of-tree configurations each get their own
# directory (build_independence, build_esp32, build_own_entry), and only the
# default one was ignored. A `git add -A` therefore committed 4906 build
# artifacts from build_own_entry before anyone noticed.
build/
build_*/
*.elf
*.map

# dependencies.lock is deliberately NOT ignored — it's the ESP-IDF
# component manager's version-pin file and must be tracked for
# reproducible builds if external components are ever added.

# Generated configuration (derived from sdkconfig.defaults)
sdkconfig
sdkconfig.old

# Python / tooling caches
.cache/
.ruff_cache/
.venv*/
__pycache__/
*.pyc

# Local logs and session scratch
*.log
*_log.txt
session-ses_*.md

# Binary payloads and compiled VM images
*.hex
*.rfxv
*.bin

# OS metadata
.DS_Store
Thumbs.db
build-host/
build_esp32/
build_independence/
release/reflex-os-*/
release/*.zip
docs/api/
sdk/python/dist/
*.egg-info/
